using System;
using System.Threading;
using System.Threading.Tasks;

class Program
{
    static int numTasks = 100000;
    static int remaining;
    static ManualResetEventSlim sem;

    static void Worker(object state)
    {
        Thread.Sleep(10000);
        if (Interlocked.Decrement(ref remaining) == 0)
            sem.Set();
    }

    static void Main(string[] args)
    {
        if (args.Length > 0) numTasks = int.Parse(args[0]);
        remaining = numTasks;
        sem = new ManualResetEventSlim(false);

        // Fixed thread pool — 1000 workers claim tasks from the ThreadPool
        var poolThreads = new Thread[1000];
        for (int t = 0; t < 1000; t++)
        {
            poolThreads[t] = new Thread(() =>
            {
                while (true)
                {
                    // Each worker processes tasks until remaining hits 0
                    if (Interlocked.Decrement(ref remaining) <= 0) break;
                    Thread.Sleep(10000);
                }
            });
            poolThreads[t].IsBackground = true;
            poolThreads[t].Start();
        }

        sem.Wait();
        Console.WriteLine("All tasks completed");
    }
}
