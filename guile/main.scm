(define (main args)
  (let ((num-tasks (if (> (length args) 1)
                       (string->number (cadr args))
                       100000))
        (remaining num-tasks)
        (lock (make-mutex))
        (cond (make-condition-variable)))
    (for-each (lambda (i)
                (make-thread
                 (lambda ()
                   (sleep 10)
                   (mutex-lock! lock)
                   (set! remaining (- remaining 1))
                   (when (= remaining 0)
                     (condition-variable-signal! cond))
                   (mutex-unlock! lock))))
              (iota num-tasks))
    (mutex-lock! lock)
    (let loop ()
      (if (> remaining 0)
          (begin
            (condition-variable-wait! cond lock)
            (loop))
          (mutex-unlock! lock)))
    (display "All tasks completed\n")))
